        <script><![CDATA[var UserDepartment = Class.create();
UserDepartment.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	getDepart: function()
	{
		var userId = this.getParameter("sysparm_id");
		var ga = new GlideRecord("sys_user");
		var dep = new GlideRecord("cmn_department");
		if(ga.get(userId))
		{
			var depsys = ga.getValue("department");
			
			if(dep.get(depsys))
			{
				return dep.getValue("name");
			}
		}
		return false;
	},

    type: 'UserDepartment'
});]]></script>
