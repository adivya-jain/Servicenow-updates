        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var ga = new GlideAjax("LabTestSlotCheck");
   ga.addParam("sysparm_name", "slotCheck");
   ga.addParam("sysparm_date", newValue);

   ga.getXMLAnswer(function(response) {
      if (response === "false") {
         g_form.showFieldMsg("scheduled_date", "No slots available for the selected date. Please choose another date.", "error");
         g_form.setValue("scheduled_date", ""); 
      } else {
         g_form.hideFieldMsg("scheduled_date");
      }
   });
}
]]></script>
