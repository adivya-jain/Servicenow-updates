        <http_method>POST</http_method>
        <name>Create Patient</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
	var requestBody = request.body.data;
	var patient = new GlideRecord('u_patient_record')

    patient.initialize();
    patient.u_first_name = requestBody.first_name;
    patient.u_last_name = requestBody.last_name;
    patient.u_dob = requestBody.dob;
    patient.u_contact_number = requestBody.contact_number;

    var patientSysId = patient.insert();
    if (patientSysId) {
        response.setStatus(201);
        return {
            status: "success",
            message: "Patient record created successfully",
            sys_id: patientSysId
        };
    } else {
        response.setStatus(500);
        return {
            status: "error",
            message: "Failed to create patient record"
        };
    }

})(request, response);]]></operation_script>
