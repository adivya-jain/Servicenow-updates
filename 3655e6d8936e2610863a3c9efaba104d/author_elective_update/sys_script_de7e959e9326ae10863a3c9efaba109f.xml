        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var gr = new GlideRecord("u_doctor");
	gr.get(current.u_doctor);

	if (current.u_doctor) {
        gs.addInfoMessage(`Appointment Scheduled for Doctor ${gr.u_first_name}`);
		gs.eventQueue("notify.appointment.schedule.patient",current,null,null);
    } else {
        gs.addInfoMessage('Appointment Scheduled (Doctor not specified).');
    }

})(current, previous);]]></script>
